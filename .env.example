# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Do NOT commit actual keys to repository
# Copy to .env and fill in your real values

REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
REACT_APP_FIREBASE_PROJECT_ID=your_project_id_here
REACT_APP_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
REACT_APP_FIREBASE_APP_ID=your_app_id_here
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# ============================================
# PAYMENT GATEWAY - PAYPAL
# ============================================
REACT_APP_PAYPAL_PAYMENT_LINK=https://www.paypal.com/qrcodes/p2pqrc/YOUR_SECURE_LINK
REACT_APP_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# ============================================
# APPLICATION SETTINGS
# ============================================
REACT_APP_APP_NAME=SocialWorkBD
REACT_APP_APP_URL=https://yourapp.com
REACT_APP_ENVIRONMENT=production

# ============================================
# SECURITY & FEATURES
# ============================================
REACT_APP_ENABLE_2FA=true
REACT_APP_ENABLE_EMAIL_VERIFICATION=true
REACT_APP_ENABLE_PAYMENT_VERIFICATION=true

# ============================================
# SESSION & TIMEOUT
# ============================================
REACT_APP_SESSION_TIMEOUT=900000

# ============================================
# PAYMENT LIMITS (USD)
# ============================================
REACT_APP_MIN_DEPOSIT=1
REACT_APP_MAX_DEPOSIT=10000
REACT_APP_MIN_WITHDRAWAL=10
REACT_APP_MAX_WITHDRAWAL=5000

# ============================================
# ADMIN SETTINGS
# ============================================
REACT_APP_ADMIN_EMAIL_VERIFICATION=false
REACT_APP_ADMIN_REQUIRE_2FA=true
