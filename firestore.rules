rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================================================
       HELPER FUNCTIONS
       ========================================================= */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    function isValidAmount(amount) {
      return amount is number && amount > 0 && amount <= 999999.99;
    }

    /* =========================================================
       USERS / PROFILES
       ========================================================= */

    match /users/{userId} {
      // Users can read own profile, admins can read all
      allow read: if isOwner(userId) || isAdmin();

      // Users can create only their own profile
      allow create: if isOwner(userId) &&
                       request.resource.data.uid == userId;

      // Users can update only safe profile fields
      // Financial fields are immutable by client
      allow update: if isOwner(userId) &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.accountId == resource.data.accountId &&
                       request.resource.data.balance == resource.data.balance &&
                       request.resource.data.pendingBalance == resource.data.pendingBalance &&
                       request.resource.data.status == resource.data.status &&
                       request.resource.data.violations == resource.data.violations &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'name', 'email', 'role', 'skills', 'bio', 'photoURL', 'location', 'title', 'updatedAt'
                       ]);

      // Users cannot delete their profile
      allow delete: if false;
    }

    /* =========================================================
       WALLET TRANSACTIONS
       ========================================================= */

    match /walletTransactions/{transactionId} {
      // Users can read only their own transactions
      allow read: if isOwner(resource.data.uid) || isAdmin();

      // Only admin/backend can create transactions
      allow create: if isAdmin();

      // Only admin can update (status changes)
      allow update: if isAdmin();

      // Transactions cannot be deleted (audit trail)
      allow delete: if false;
    }

    /* =========================================================
       PAYMENT REQUESTS
       ========================================================= */

    match /paymentRequests/{paymentId} {
      // Users can read only their own requests, admins read all
      allow read: if isOwner(resource.data.uid) || isAdmin();

      // Users can create pending payment requests for themselves
      allow create: if isSignedIn() &&
                       request.resource.data.uid == request.auth.uid &&
                       isValidAmount(request.resource.data.amount) &&
                       request.resource.data.amount >= 1 &&
                       request.resource.data.amount <= 10000 &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.currency == 'USD';

      // Only admins can approve/update payments
      allow update: if isAdmin() &&
                       resource.data.uid == request.resource.data.uid &&
                       resource.data.amount == request.resource.data.amount;

      // Payment requests cannot be deleted
      allow delete: if false;
    }

    /* =========================================================
       JOBS
       ========================================================= */

    match /jobs/{jobId} {
      // Public: anyone can read open jobs
      // Private: owners and admins can read their own
      allow read: if resource.data.status == 'open' ||
                     isOwner(resource.data.ownerId) ||
                     isAdmin();

      // Authenticated users can create jobs
      allow create: if isSignedIn() &&
                       request.resource.data.ownerId == request.auth.uid;

      // Owners can update their jobs (ownership cannot transfer)
      allow update: if isOwner(resource.data.ownerId) &&
                       request.resource.data.ownerId == resource.data.ownerId;

      // Owners can delete their jobs
      allow delete: if isOwner(resource.data.ownerId);
    }

    /* =========================================================
       PROPOSALS
       ========================================================= */

    match /proposals/{proposalId} {
      // Workers can read their proposals, clients can read proposals on their jobs
      allow read: if isSignedIn() &&
                     (isOwner(resource.data.workerId) ||
                      isOwner(resource.data.clientId) ||
                      isAdmin());

      // Workers can create proposals with their UID
      allow create: if isSignedIn() &&
                       request.resource.data.workerId == request.auth.uid;

      // Workers/clients can update their proposals
      allow update: if isSignedIn() &&
                       ((isOwner(resource.data.workerId) &&
                         request.resource.data.workerId == resource.data.workerId) ||
                        (isOwner(resource.data.clientId) &&
                         request.resource.data.clientId == resource.data.clientId));

      // Proposals cannot be deleted
      allow delete: if false;
    }

    /* =========================================================
       MODERATION EVENTS
       ========================================================= */

    match /moderationEvents/{eventId} {
      // Users can create events for themselves
      allow create: if isSignedIn() &&
                       request.resource.data.uid == request.auth.uid;

      // Users cannot read or modify moderation records
      allow read, update, delete: if false;
    }

    /* =========================================================
       ADMIN LOGS
       ========================================================= */

    match /adminLogs/{logId} {
      // Only admins can read logs
      allow read: if isAdmin();

      // Only admins can create logs
      allow create: if isAdmin();

      // Logs cannot be modified or deleted (audit trail)
      allow update, delete: if false;
    }

    /* =========================================================
       DEFAULT DENY
       ========================================================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
