rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - প্রতিটি ব্যবহারকারী নিজের ডেটা পড়া এবং লেখা যাবে
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
      allow read: if request.auth != null; // অন্যদের profile দেখতে পারবে
    }
    
    // Jobs collection - সবাই দেখতে পারবে, কিন্তু শুধু মালিক edit করতে পারবে
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null && 
                       request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth.uid == resource.data.ownerId;
    }
    
    // Proposals collection - সংশ্লিষ্ট পক্ষ দেখতে পারবে, সবাই তৈরি করতে পারবে
    match /proposals/{proposalId} {
      allow create: if request.auth != null &&
                       request.resource.data.workerId == request.auth.uid;
      allow read: if request.auth.uid == resource.data.workerId || 
                     request.auth.uid == resource.data.clientId;
      allow update, delete: if request.auth.uid == resource.data.workerId || 
                               request.auth.uid == resource.data.clientId;
    }
    
    // Moderation Events - শুধু authenticated ব্যবহারকারী তৈরি করতে পারবে
    match /moderationEvents/{eventId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
